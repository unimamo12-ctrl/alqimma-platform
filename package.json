{
    "name": "alqimma-platform",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx server.ts",
        "dev:next": "next dev",
        "build": "node scripts/deploy-bootstrap.mjs && next build",
        "start": "cross-env NODE_ENV=production tsx server.ts",
        "start:next": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "smoke": "node scripts/smoke.mjs",
        "smoke:live": "node scripts/smoke-student-live.mjs",
        "smoke:webrtc": "node scripts/smoke-webrtc.mjs",
        "check:quality": "tsx scripts/check-quality-policy.mjs",
        "check:ratelimit": "tsx scripts/check-ratelimit-identity.mjs",
        "check:integrity": "node scripts/check-integrity.mjs",
        "e2e:live": "node scripts/e2e-live.mjs",
        "e2e:recording": "node scripts/e2e-recording.mjs",
        "e2e:quiz": "node scripts/e2e-quiz.mjs",
        "cleanup:sessions": "node scripts/cleanup-test-sessions.mjs",
        "verify": "npm run typecheck && npm run lint && npm run check:quality && npm run check:ratelimit && npm run check:integrity && npm run smoke && npm run smoke:live && npm run smoke:webrtc && npm run e2e:live && npm run e2e:recording && npm run e2e:quiz && npm run e2e:auth && npm run e2e:nocourses && npm run e2e:dark && npm run e2e:dark-hover && npm run e2e:bootstrap && npm run e2e:sweep && npm run cleanup:sessions",
        "seed": "tsx prisma/seed.ts",
        "bootstrap:deploy": "node scripts/deploy-bootstrap.mjs",
        "e2e:bootstrap-deploy": "node scripts/e2e-deploy-bootstrap.mjs",
        "postinstall": "prisma generate",
        "e2e:nocourses": "node scripts/e2e-no-courses.mjs",
        "e2e:dark": "node scripts/e2e-dark.mjs",
        "e2e:dark-hover": "node scripts/e2e-dark-hover.mjs",
        "e2e:bootstrap": "node scripts/e2e-bootstrap.mjs",
        "e2e:sweep": "node scripts/e2e-sweep.mjs",
        "e2e:auth": "node scripts/e2e-auth.mjs"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^3.0.3",
        "jsonwebtoken": "^9.0.3",
        "next": "16.3.7",
        "prisma": "^5.22.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "cross-env": "^7.0.3",
        "eslint": "^9",
        "eslint-config-next": "16.3.7",
        "playwright": "^1.63.0",
        "tailwindcss": "^4",
        "tsx": "^4.20.3",
        "typescript": "^5"
    }
}
