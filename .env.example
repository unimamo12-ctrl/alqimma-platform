# Copy to .env and fill in. Never commit the real .env -- it is already ignored.

# ---------------------------------------------------------------- required
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------- auth secrets
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
REFRESH_TOKEN_SECRET=""
PASSWORD_RESET_SECRET=""

# ---------------------------------------------------------------- password reset delivery
# A webhook is the real delivery path. Without one, a reset link is only printed
# to the deploy log, and only when ALLOW_INSECURE_DEV_RESET is explicitly set.
PASSWORD_RESET_WEBHOOK_URL=""

# Hands the working reset token back in the API response. Development only.
# It is opt-in on purpose: an unset NODE_ENV used to make this true in production,
# which let anyone take over any account by requesting a reset.
ALLOW_INSECURE_DEV_RESET=""

# ---------------------------------------------------------------- first deploy
# Read by scripts/deploy-bootstrap.mjs, which `npm run build` runs. Needed only
# when the platform has no admin at all: an existing admin is never touched, so
# this cannot reset a live password on a redeploy.
ADMIN_EMAIL="admin@alqimma.com"
# Leave empty to have one generated and printed once in the deploy log.
ADMIN_PASSWORD=""
# Only when you have lost the generated password and have no shell. Requires
# ADMIN_PASSWORD to be set, or the build fails rather than half-doing it.
# REMOVE IT as soon as the deploy succeeds: while it is set, every later deploy
# resets that account's password, including one triggered by someone else.
ADMIN_FORCE_RESET=""

# ---------------------------------------------------------------- live video
# Comma-separated so UDP and TCP can be offered together. Inlined at build time,
# so changing them needs a full rebuild. A time-limited HMAC endpoint should
# replace the static credential before this is public.
NEXT_PUBLIC_TURN_URL=""
NEXT_PUBLIC_TURN_USERNAME=""
NEXT_PUBLIC_TURN_CREDENTIAL=""
